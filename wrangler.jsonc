{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liftedtrucksneworleans",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "www.liftedtrucksneworleans.com", "custom_domain": true },
    { "pattern": "liftedtrucksneworleans.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
